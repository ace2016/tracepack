{
  "name": "@tracepack/extension",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @tracepack/workspace build && vite build && node scripts/copy-workspace.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "e2e": "pnpm build && node e2e/smoke.mjs"
  },
  "dependencies": {
    "@tracepack/storage": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.1",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.56.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
