{
  "name": "@tracepack/extension",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @tracepack/workspace build && vite build && node scripts/copy-workspace.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "e2e": "pnpm build && node e2e/smoke.mjs"
  },
  "dependencies": {
    "@tracepack/storage": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
