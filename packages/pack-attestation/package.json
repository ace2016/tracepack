{
  "name": "@tracepack/pack-attestation",
  "version": "0.2.1",
  "description": "Integration layer binding immutable TracePack pack snapshots to portable attestation subjects.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@tracepack/attestation": "workspace:*",
    "@tracepack/evidence-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ace2016/tracepack.git",
    "directory": "packages/pack-attestation"
  },
  "homepage": "https://dev.tracepack.org/",
  "bugs": {
    "url": "https://github.com/ace2016/tracepack/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ]
}
