{
  "name": "@tracepack/evidence-sdk",
  "version": "0.1.0",
  "description": "Portable TypeScript SDK for the tracepack-evidence v1 interchange contract: types, schema validation, and RFC 8785 canonicalization/hashing. Zero Tracepack-internal or browser-only dependencies, so it runs anywhere Node or a bundler does.",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/ace2016/tracepack.git", "directory": "packages/evidence-sdk" },
  "homepage": "https://dev.tracepack.org/",
  "bugs": { "url": "https://github.com/ace2016/tracepack/issues" },
  "publishConfig": { "access": "public", "provenance": true },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./schema/tracepack-evidence.v1.json": "./schema/tracepack-evidence.v1.json"
  },
  "files": ["dist", "schema", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "dependencies": {
    "canonicalize": "^3.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": { "node": ">=18" }
}
