{
  "name": "@tracepack/evidence-core",
  "version": "0.1.0",
  "description": "Tracepack's core domain model — EvidenceItem, TracepackProject, TemplateSnapshot — and the pure functions that operate on them (progress, category state, chronology gaps). No framework or runtime dependency.",
  "license": "Apache-2.0",
  "author": "Spendmita Ltd",
  "homepage": "https://dev.tracepack.org",
  "repository": { "type": "git", "url": "git+https://github.com/ace2016/tracepack.git", "directory": "packages/evidence-core" },
  "bugs": { "url": "https://github.com/ace2016/tracepack/issues" },
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "devDependencies": { "esbuild": "^0.28.1", "typescript": "^5.9.2", "vitest": "^3.2.4" },
  "engines": { "node": ">=18" }
}
